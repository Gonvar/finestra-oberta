{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finestra-oberta",
  "compatibility_date": "2026-11-22",
  // Astro genera la web a dist i Cloudflare la serveix tal com és. Només /mcp, el servidor MCP de les
  // dades publicades, passa pel codi del Worker.
  "main": "src/worker.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/mcp"] },
  "routes": [{ "pattern": "finestraoberta.cat", "custom_domain": true }],
  "observability": { "enabled": true },
  // La foto del transport, als minuts 7 i 37 de cada hora (UTC): el Worker llança el workflow
  // transport.yml. Necessita el secret GITHUB_TOKEN (wrangler secret put GITHUB_TOKEN).
  "triggers": { "crons": ["7,37 * * * *"] },
  // Workers Builds publica cada branca i cada pull request com a previsualització amb `wrangler preview`.
  "previews": {},
}
