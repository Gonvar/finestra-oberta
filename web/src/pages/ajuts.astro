---
import Pagina from '../layouts/Pagina.astro';
import '../styles/subpagines.css';
import { dia, nombre } from '../dades/institucions.ts';
import { milions } from '../dades/pressupost.ts';
import { REPO } from '../dades/portada.ts';
import { part } from '../dades/contractes.ts';
import { BENEFICIARIS, TIPUS, administracio, ajuts, convocatoriesEnText, resum } from '../dades/ajuts.ts';

const r = resum(ajuts.convocatories, ajuts.data_dades);
const fins = dia(ajuts.data_dades);
const DADES = `${REPO}/blob/dades/ajuts.json`;
const amplada = (valor: number) => `width: ${valor * 100}%`;
const seccions = [
  {
    id: 'finalitats',
    titol: 'Per a què són',
    explica: 'La finalitat que en diu la font.',
    grups: r.finalitats.map((g) => ({ ...g, etiqueta: g.nom })),
  },
  {
    id: 'administracions',
    titol: 'Qui les convoca',
    explica: 'Quin tipus d’administració ha fet la convocatòria.',
    grups: r.administracions.map((g) => ({ ...g, etiqueta: administracio(g.nom) })),
  },
  {
    id: 'beneficiaris',
    titol: 'Per a qui són',
    explica:
      'Una convocatòria pot ser per a més d’un tipus de beneficiari, i llavors compta a cadascun. Per això les parts sumen més del 100 %.',
    grups: r.beneficiaris.map((g) => ({
      ...g,
      etiqueta: Object.hasOwn(BENEFICIARIS, g.nom) ? BENEFICIARIS[g.nom] : g.nom,
    })),
  },
];
---

<Pagina>
  <main class="contingut">
    <section class="capcalera" aria-labelledby="titol">
      <p class="etiqueta entra"><span class="punt dad" aria-hidden="true"></span>Administracions de Catalunya</p>
      <h1 id="titol" class="entra" style="--ordre: 1">Quins ajuts es poden demanar</h1>
      <p class="entradeta entra" style="--ordre: 2">
        Les convocatòries d'ajuts i subvencions que encara no han tancat el termini, per a què són i a qui van.
      </p>
    </section>

    <section class="seccio entra" style="--ordre: 3" aria-labelledby="total-titol">
      <h2 class="visualment-amagat" id="total-titol">Quantes convocatòries</h2>
      <p class="valor">{convocatoriesEnText(r.total, nombre)}</p>
      <p class="que">
        que el {fins} encara no havien tancat el termini, per {milions(r.import)} d'euros en total.
        {r.perObrir > 0 && <Fragment>{' '}{nombre(r.perObrir)} encara no l'han obert.</Fragment>}
      </p>
      <p class="font-dada">
        Font: <a href={ajuts.url}>Registre de subvencions i ajuts de Catalunya (RAISC)</a>, Departament d'Economia i
        Finances, actualitzat el {fins}.
      </p>
    </section>

    <section class="seccio" aria-labelledby="tipus-titol">
      <h2 class="titol-seccio" id="tipus-titol">Com es donen</h2>
      <ol class="grups">
        {
          r.tipus.map((t) => (
            <li>
              <h3 class="nom">{t.nom}</h3>
              {Object.hasOwn(TIPUS, t.nom) && <p class="secundari explicacio">{TIPUS[t.nom]}</p>}
              <span class="pista" aria-hidden="true">
                <span class="ple" style={amplada(t.part)} />
              </span>
              <p class="xifra">
                {convocatoriesEnText(t.convocatories, nombre)} ({part(t.part)})
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      seccions.map((s) => (
        <section class="seccio" aria-labelledby={`${s.id}-titol`}>
          <h2 class="titol-seccio" id={`${s.id}-titol`}>
            {s.titol}
          </h2>
          <p class="explica">{s.explica}</p>
          <ol class="grups">
            {s.grups.map((g) => (
              <li>
                <h3 class="nom">{g.etiqueta}</h3>
                <span class="pista" aria-hidden="true">
                  <span class="ple" style={amplada(g.part)} />
                </span>
                <p class="xifra">
                  {convocatoriesEnText(g.convocatories, nombre)} ({part(g.part)})
                </p>
              </li>
            ))}
          </ol>
          <p class="font-dada">
            Font: <a href={ajuts.url}>RAISC</a>, actualitzat el {fins}.
          </p>
        </section>
      ))
    }

    <section class="seccio" aria-labelledby="detall-titol">
      <h2 class="titol-seccio" id="detall-titol">Cada convocatòria</h2>
      <p class="explica">
        A les <a href={DADES}>dades completes</a> hi ha cada convocatòria amb el títol, qui la fa, el termini i l'enllaç
        a les bases i a la seu electrònica on es demana.
      </p>
      {
        r.senseImport > 0 && (
          <p class="explica">{convocatoriesEnText(r.senseImport, nombre)} no tenen import a la font i no se sumen al total.</p>
        )
      }
      <p class="font-dada">
        Font: <a href={ajuts.url}>Registre de subvencions i ajuts de Catalunya (RAISC)</a>, de Dades obertes de Catalunya.
      </p>
    </section>
  </main>
</Pagina>

<style>
  .punt.dad {
    background: var(--dad);
  }

  .valor {
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    text-wrap: balance;
  }

  .que {
    margin-top: 0.75rem;
    max-width: 38rem;
    font-size: 1.1875rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .explica {
    margin-top: 1rem;
    max-width: 40rem;
    color: var(--ink-2);
  }

  .grups {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    max-width: 48rem;
  }

  .grups > li {
    padding: 1rem 0;
    box-shadow: inset 0 1px 0 var(--hair);
  }

  .nom {
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .explicacio {
    margin-top: 0.125rem;
  }

  /* El fons clar és la resta del total; el contorn fa que es vegi sobre el blanc (WCAG 1.4.11). */
  .pista {
    display: block;
    margin-top: 0.625rem;
    height: 0.75rem;
    border-radius: 999px;
    background: var(--dad-tint);
    box-shadow: inset 0 0 0 1px var(--dad);
    overflow: hidden;
  }

  .ple {
    display: block;
    min-width: 3px;
    height: 100%;
    background: var(--dad);
  }

  .xifra {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .seccio > .font-dada {
    margin-top: 1.5rem;
  }
</style>
