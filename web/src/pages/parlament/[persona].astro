---
import Pagina from '../../layouts/Pagina.astro';
import BlocsDeclaracio from '../../components/BlocsDeclaracio.astro';
import '../../styles/subpagines.css';
import { dia, diaCurt, euros, nombre, parlament, slug } from '../../dades/institucions.ts';
import {
  actesFets,
  alDia,
  ambGrupInteres,
  deMes,
  delDia,
  diputats,
  elDia,
  organsActuals,
  perfils,
  presentacio,
  rendesDarrerAny,
  type Diputat,
} from '../../dades/diputats.ts';

export function getStaticPaths() {
  return perfils.map((perfil) => ({
    params: { persona: slug(perfil.composicio.nom) },
    props: { perfil },
  }));
}

type Props = { perfil: Diputat };
const { composicio: c, fitxa: f } = Astro.props.perfil;

const grup = parlament.grups.find((g) => g.nom === c.grup);
if (grup === undefined) throw new Error(`El grup ${c.grup} no és a parlament.json.`);

const rendes = rendesDarrerAny(f);
const organs = organsActuals(f.carrecs);
const { actes } = f.agenda;
const fets = actesFets(actes);
const reunions = ambGrupInteres(actes);
const mes = deMes(diputats.agenda.mes);
const consultada = `consultada ${elDia(dia(diputats.data_consulta))}`;
const majuscula = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const periode = (r: { alta: string; baixa?: string }) =>
  r.baixa === undefined
    ? `Des ${delDia(diaCurt(r.alta))}`
    : `${majuscula(delDia(diaCurt(r.alta)))} ${alDia(diaCurt(r.baixa))}`;
---

<Pagina>
  <main class="contingut">
    <section class="capcalera" aria-labelledby="titol">
      <p class="etiqueta entra"><a href="/parlament"><span class="punt par" aria-hidden="true"></span>Parlament</a></p>
      <div class="persona">
        {'foto' in c ? <img class="entra" src={c.foto} alt="" width="300" height="400" decoding="async" /> : <span class="sense-foto" />}
        <div>
          <h1 id="titol" class="entra" style="--ordre: 1">{c.nom}</h1>
          <p class="entradeta entra" style="--ordre: 2">
            <span class="color" style={`--color: ${grup.color}`} aria-hidden="true"></span>{presentacio(c)}. {
              grup.nom
            }.
          </p>
        </div>
      </div>

      <div class="xifres entra" style="--ordre: 3">
        <div>
          {
            rendes ? (
              <>
                <p class="valor">{euros(rendes.total)}</p>
                <p class="que">Cobrat del Parlament el {rendes.any}</p>
              </>
            ) : (
              <p class="que">El Parlament encara no n'ha publicat les rendes.</p>
            )
          }
          <p class="font-dada"><a href="#rendes-titol">Rendes</a>, {dia(diputats.data_consulta)}</p>
        </div>
        <div>
          <p class="valor">{nombre(organs.length)}</p>
          <p class="que">Comissions i altres òrgans on és ara</p>
          <p class="font-dada"><a href="#organs-titol">Fitxa del Parlament</a>, {dia(diputats.data_consulta)}</p>
        </div>
        <div>
          <p class="valor">{nombre(fets.length)}</p>
          <p class="que">Actes que ha informat a la seva agenda {mes}</p>
          {reunions.length > 0 && <p class="que">{nombre(reunions.length)} amb grups d'interès.</p>}
          <p class="font-dada"><a href="#agenda-titol">Agenda</a>, {dia(diputats.data_consulta)}</p>
        </div>
      </div>
    </section>

    <section class="seccio" aria-labelledby="organs-titol">
      <h2 class="titol-seccio" id="organs-titol">On treballa i on ha treballat</h2>
      <p class="explica">
        Al Parlament, les lleis es preparen en comissions i ponències: grups petits de persones diputades de tots els
        grups.
      </p>
      {
        f.carrecs.length === 0 ? (
          <p class="buit">La fitxa no diu cap òrgan.</p>
        ) : (
          <ul class="files">
            {f.carrecs.map((o) => (
              <li>
                <p class="destacat">
                  {o.url !== undefined ? <a href={o.url}>{o.organ}</a> : o.organ}
                </p>
                {'alta' in o && (
                  <p class="secundari">
                    {o.carrec !== undefined && `${o.carrec}. `}
                    {periode(o)}.
                  </p>
                )}
                {o.relacionats !== undefined && (
                  <ul class="relacionats">
                    {o.relacionats.map((r) => (
                      <li>
                        {r.url !== undefined ? <a href={r.url}>{r.organ}</a> : r.organ}
                        <span class="secundari">
                          {' '}
                          · {r.carrec !== undefined && `${r.carrec}. `}
                          {periode(r)}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        )
      }
      <p class="font-dada">
        Font: <a href={f.fitxa}>fitxa del Parlament</a>, {consultada}.
      </p>
    </section>

    <section class="seccio" aria-labelledby="agenda-titol">
      <h2 class="titol-seccio" id="agenda-titol">Agenda {mes}</h2>
      {
        reunions.length > 0 && (
          <p class="explica">
            Un grup d'interès és una organització o una persona que intenta influir en les decisions del Parlament.
          </p>
        )
      }
      {
        actes.length === 0 ? (
          <p class="buit">No hi ha cap acte a la seva agenda {mes}.</p>
        ) : (
          <ol class="files cronologia">
            {actes.map((a) => (
              <li>
                <time datetime={a.data}>
                  {diaCurt(a.data)}
                  {a.hora !== undefined && <span class="hora">{a.hora}{a.fins !== undefined && `–${a.fins}`}</span>}
                </time>
                <div>
                  <p class="destacat">{a.titol}</p>
                  {a.detalls.map((d) => (
                    <p class="secundari">{d}</p>
                  ))}
                  {a.desconvocat !== undefined && <p class="secundari">Desconvocat {elDia(dia(a.desconvocat))}.</p>}
                </div>
              </li>
            ))}
          </ol>
        )
      }
      <p class="font-dada">
        L'agenda la informa cada persona diputada.
        Font: <a href={f.agenda.url}>agenda al web del Parlament</a>, {consultada}.
      </p>
    </section>

    <section class="seccio" aria-labelledby="rendes-titol">
      <h2 class="titol-seccio" id="rendes-titol">Què ha cobrat del Parlament</h2>
      {
        f.rendes !== undefined ? (
          <>
            <BlocsDeclaracio blocs={f.rendes.blocs} />
            <p class="font-dada">
              Font: <a href={f.rendes.url}>{f.rendes.titol}</a>
              {f.rendes.data !== undefined && `, publicades ${elDia(dia(f.rendes.data))}`}.
            </p>
          </>
        ) : (
          <p class="buit">El Parlament encara no n'ha publicat les rendes.</p>
        )
      }
    </section>

    <section class="seccio" aria-labelledby="declaracions-titol">
      <h2 class="titol-seccio" id="declaracions-titol">Què declara</h2>
      {
        f.declaracions.length === 0 && f.compromisos.length === 0 && (
          <p class="buit">La fitxa no enllaça cap declaració.</p>
        )
      }
      {
        f.declaracions.map((d) => (
          <details>
            <summary>
              {d.titol}
              {d.data !== undefined && <span class="secundari">, {diaCurt(d.data)}</span>}
            </summary>
            <BlocsDeclaracio blocs={d.blocs} />
            <p class="font-dada">
              Font: <a href={d.url}>{d.titol}</a> al web del Parlament.
            </p>
          </details>
        ))
      }
      {
        f.compromisos.length > 0 && (
          <ul class="compromisos">
            {f.compromisos.map((k) => (
              <li>
                <a href={k.url}>{k.titol}</a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="seccio" aria-labelledby="biografia-titol">
      <h2 class="titol-seccio" id="biografia-titol">Biografia</h2>
      {
        f.biografia === undefined ? (
          <p class="buit">La fitxa no té biografia.</p>
        ) : (
          <>
            <div class="biografia">
              {f.biografia.apartats.map((a) => (
                <>
                  <h3 class="titol-bloc">{a.titol}</h3>
                  {a.linies.map((l) => (
                    <p>{l}</p>
                  ))}
                </>
              ))}
            </div>
            <p class="font-dada">
              L'ha escrita la mateixa persona. {f.biografia.data.que === 'Actualització' ? 'Actualitzada' : 'Presentada'}{' '}
              {elDia(dia(f.biografia.data.dia))}.
            </p>
          </>
        )
      }
    </section>

    <section class="seccio" aria-labelledby="falta-titol">
      <h2 class="titol-seccio" id="falta-titol">Què no hi és</h2>
      <p class="explica">
        El Parlament no publica què vota cada persona ni si va a cada sessió. Les preguntes, les propostes i les
        intervencions es poden buscar des de la seva <a href={f.fitxa}>fitxa del Parlament</a>.
      </p>
    </section>
  </main>
</Pagina>

<style>
  .persona {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }

  @media (min-width: 768px) {
    .persona img,
    .sense-foto {
      max-width: 14rem;
    }

    .persona {
      grid-template-columns: minmax(10rem, 14rem) 1fr;
      gap: 2.5rem;
    }
  }

  .persona img,
  .sense-foto {
    width: 100%;
    max-width: 10rem;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 14px;
    background: var(--par-tint);
  }

  .color {
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    margin-right: 0.5rem;
    border-radius: 999px;
    background: var(--color);
  }

  .etiqueta a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }

  .explica {
    margin-top: 1rem;
    max-width: 44rem;
    color: var(--ink-2);
  }

  .buit {
    margin-top: 1.5rem;
    max-width: 36rem;
    color: var(--ink-2);
  }

  .destacat {
    font-size: 1.1875rem;
    line-height: 1.45;
    letter-spacing: -0.012em;
  }

  .secundari {
    margin-top: 0.25rem;
    max-width: 44rem;
  }

  .relacionats {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
  }

  .relacionats li + li {
    margin-top: 0.5rem;
  }

  .cronologia li {
    display: grid;
    gap: 0.25rem;
  }

  @media (min-width: 768px) {
    .cronologia li {
      grid-template-columns: 110px 1fr;
      gap: 1.5rem;
    }
  }

  time {
    font-size: 0.9375rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .hora {
    display: block;
  }

  details {
    margin-top: 1rem;
    padding-top: 0.5rem;
    box-shadow: inset 0 1px 0 var(--hair);
  }

  summary {
    min-height: 44px;
    padding: 0.625rem 0;
    cursor: pointer;
    color: var(--par);
  }

  details > .font-dada {
    margin: 1rem 0;
  }

  .compromisos {
    margin: 1.5rem 0 0;
    padding-left: 1.25rem;
    max-width: 44rem;
  }

  .compromisos li + li {
    margin-top: 0.5rem;
  }

  .biografia {
    margin-top: 1rem;
    max-width: 44rem;
    color: var(--ink-2);
  }

  .biografia h3 {
    margin-top: 1.5rem;
    color: var(--ink);
  }

  .seccio > .font-dada {
    margin-top: 1.25rem;
    max-width: 44rem;
  }
</style>
