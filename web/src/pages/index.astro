---
import '../styles/global.css';
import Navegacio from '../components/Navegacio.astro';
import Cercador from '../components/Cercador.tsx';
import BlocInstitucio from '../components/BlocInstitucio.astro';
import Cronologia from '../components/Cronologia.astro';
import Xifra from '../components/Xifra.astro';
import BlocIA from '../components/BlocIA.astro';
import Peu from '../components/Peu.astro';
import { blocs, cronologia, preguntes, respostes, xifra } from '../dades/portada.ts';

const llocs = [
  { nom: 'Què ha passat', href: '#cronologia' },
  ...blocs.flatMap((b) => (b.href ? [{ nom: b.titol, href: b.href }] : [])),
];
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>Finestra Oberta</title>
    <meta
      name="description"
      content="Les dades obertes de les institucions catalanes, amb la font i la data de cada dada."
    />
  </head>
  <body>
    <Navegacio />
    <main class="contingut">
      <section class="portada" aria-labelledby="portada-titol">
        <h1 id="portada-titol" class="entra">
          Què decideix el Govern.<br /><span class="segona">Ara, a la vista.</span>
        </h1>
        <p class="entradeta entra" style="--ordre: 1">
          Les dades obertes de les institucions catalanes, amb la font i la data de cada dada.
        </p>
        <div class="entra" style="--ordre: 2">
          <Cercador client:load exemple="Quanta gent viu al meu municipi?" preguntes={preguntes} respostes={respostes} llocs={llocs} />
        </div>
      </section>

      <section class="seccio" aria-label="Institucions">
        <div class="blocs">
          {blocs.map((bloc, i) => <BlocInstitucio bloc={bloc} ordre={3 + i} />)}
        </div>
      </section>

      <Cronologia fets={cronologia} />
      <Xifra xifra={xifra} />
      <BlocIA />
    </main>
    <Peu />
  </body>
</html>

<style>
  .portada {
    padding-top: clamp(3.5rem, 9vw, 6.5rem);
  }

  h1 {
    font-size: clamp(3rem, 8.4vw, 6rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .segona {
    color: var(--gov);
  }

  .entradeta {
    margin-top: 1.5rem;
    max-width: 36rem;
    font-size: 1.1875rem;
    line-height: 1.45;
    letter-spacing: -0.012em;
    color: var(--ink-2);
  }

  .portada > div {
    margin-top: 2.5rem;
    max-width: 44rem;
  }

  .blocs {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 900px) {
    .blocs {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
