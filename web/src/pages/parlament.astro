---
import Pagina from '../layouts/Pagina.astro';
import '../styles/subpagines.css';
import { dia, parlament } from '../dades/institucions.ts';
import { codi, rutaDiputat } from '../dades/diputats.ts';

const grups = parlament.grups.map((g, i) => ({
  ...g,
  i,
  diputats: parlament.diputats.filter((d) => d.grup === g.nom),
}));
const majoria = Math.floor(parlament.escons / 2) + 1;

// Cada persona seu on la situa el mapa d'escons del Parlament, amb el color del seu grup.
const ocupats = grups.flatMap((grup) => grup.diputats.map((diputat) => ({ grup, diputat })));
const RADI = 9;
const xs = ocupats.map((s) => s.diputat.posicio.x);
const ys = ocupats.map((s) => s.diputat.posicio.y);
const marc = [
  Math.min(...xs) - RADI - 2,
  Math.min(...ys) - RADI - 2,
  Math.max(...xs) - Math.min(...xs) + 2 * RADI + 4,
  Math.max(...ys) - Math.min(...ys) + 2 * RADI + 4,
].join(' ');

// En passar per sobre d'un grup de la llegenda, la resta d'escons s'apaguen.
const ressalta = grups
  .map(
    (g) =>
      `.parlament:has(.llegenda [data-grup="${g.i}"]:is(:hover, :focus-visible)) .seient:not([data-grup="${g.i}"]) { opacity: 0.15; }`,
  )
  .join('\n');
---

<Pagina>
  <main class="contingut" id="principal">
  <section class="capcalera" aria-labelledby="titol">
    <p class="etiqueta entra"><span class="punt par" aria-hidden="true"></span>Parlament de Catalunya</p>
    <h1 id="titol" class="entra" style="--ordre: 1">Qui seu al Parlament</h1>
    <p class="entradeta entra" style="--ordre: 2">
      {parlament.escons} escons en {grups.length} grups. {parlament.legislatura.numero} legislatura, des del {
        parlament.legislatura.inici
      }.
    </p>
    <p class="entra decisions" style="--ordre: 3"><a href="/parlament/decisions">Què ha decidit el Parlament</a></p>
  </section>

  <section class="seccio parlament entra" style="--ordre: 4" aria-labelledby="grups-titol">
    <h2 class="visualment-amagat" id="grups-titol">Escons per grup</h2>
    <div class="distribucio">
      <figure class="hemicicle">
        <svg viewBox={marc} aria-hidden="true">
          {
            ocupats.map((s) => (
              <a href={`#diputat-${codi(s.diputat.fitxa)}`} tabindex="-1">
                <circle
                  class="seient"
                  data-grup={s.grup.i}
                  cx={s.diputat.posicio.x}
                  cy={s.diputat.posicio.y}
                  r={RADI}
                  style={`--color: ${s.grup.color}`}
                >
                  <title>
                    {s.diputat.nom} · {s.grup.sigla}
                  </title>
                </circle>
              </a>
            ))
          }
        </svg>
        <figcaption>
          <span class="total">{parlament.escons}</span>
          <span class="secundari">escons · majoria absoluta, {majoria}</span>
        </figcaption>
      </figure>

      <ol class="llegenda" aria-label="Escons per grup">
        {
          grups.map((g) => (
            <li>
              <a href={`#grup-${g.i}`} data-grup={g.i}>
                <span class="color" style={`--color: ${g.color}`} aria-hidden="true" />
                <span class="noms">
                  <span class="curt">{g.sigla}</span>
                  <span class="secundari">{g.nom}</span>
                </span>
                <span class="escons">{g.escons}</span>
                <span
                  class="barra"
                  style={`--part: ${g.escons / parlament.escons}; --color: ${g.color}`}
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
    <p class="explica">
      Cada punt és un escó, al lloc on seu cada diputat. Els diputats d'un mateix partit o coalició formen un
      grup parlamentari, i els que no en formen cap van al Grup Mixt. La majoria absoluta és la meitat dels escons
      més un.
    </p>
    <p class="font-dada">
      Font: <a href={parlament.url}>mapa d'escons del Parlament de Catalunya</a>, amb els seus colors, consultat
      el {dia(parlament.data_consulta)}. Els grups són els d'avui, que poden no coincidir amb els resultats de
      les eleccions.
    </p>
  </section>

  {
    grups.map((g) => (
      <section class="seccio grup" id={`grup-${g.i}`} aria-labelledby={`grup-${g.i}-titol`}>
        <h2 class="titol-seccio" id={`grup-${g.i}-titol`}>
          <span class="color gran" style={`--color: ${g.color}`} aria-hidden="true" />
          {g.sigla}
          <span class="secundari compte">{g.escons}</span>
        </h2>
        <p class="secundari nom-grup">
          {g.nom}
          {'subgrups' in g && g.subgrups.map((s) => `. Inclou el ${s.nom}, amb ${s.escons} ${s.escons === 1 ? 'escó' : 'escons'}`)}.
        </p>
        <ul class="diputats">
          {[...g.diputats]
            .sort((a, b) => a.nom.localeCompare(b.nom, 'ca'))
            .map((d) => (
              <li id={`diputat-${codi(d.fitxa)}`}>
                <a href={rutaDiputat(d.nom)}>
                  {'foto' in d ? (
                    <img src={d.foto} alt="" loading="lazy" decoding="async" width="300" height="400" />
                  ) : (
                    <span class="sense-foto" />
                  )}
                  <span class="nom">{d.nom}</span>
                  <span class="secundari">
                    {d.circumscripcio}
                    {d.carrec !== 'Diputat' && d.carrec !== 'Diputada' && ` · ${d.carrec}`}
                  </span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
  <p class="font-dada credit">
    Fotos: <a href={parlament.url}>Parlament de Catalunya</a>.
  </p>
  </main>
  <style is:inline set:html={ressalta} />
</Pagina>

<style>
  .decisions {
    margin-top: 1rem;
  }

  .decisions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .distribucio {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 56.25em) {
    .distribucio {
      grid-template-columns: 3fr 2fr;
      gap: 3.5rem;
    }
  }

  .hemicicle {
    position: relative;
    margin: 0;
  }

  .hemicicle svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .seient {
    fill: var(--color);
    /* Alguns colors del Parlament, com el groc, gairebé no es veuen sobre blanc sense contorn. */
    stroke: rgba(0, 0, 0, 0.14);
    stroke-width: 1.2;
    transition: opacity var(--t-bloc) var(--ease-out);
  }

  .hemicicle a:hover .seient {
    stroke: var(--ink);
    stroke-width: 2.4;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 0.75rem;
  }

  .total {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .llegenda {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .llegenda a {
    display: grid;
    grid-template-columns: 0.875rem 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 0.75rem;
    align-items: center;
    min-height: 44px;
    padding: 0.625rem 0;
    color: inherit;
    text-decoration: none;
    box-shadow: inset 0 1px 0 var(--hair);
  }

  .color {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 999px;
    background: var(--color);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.14);
    flex: none;
  }

  .color.gran {
    display: inline-block;
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.625rem;
    vertical-align: 0.05em;
  }

  .noms {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .curt {
    font-size: 1.1875rem;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .noms .secundari {
    font-size: 0.8125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .escons {
    font-size: 1.1875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .barra {
    grid-column: 2 / 4;
    height: 3px;
    margin-top: 0.5rem;
    border-radius: 999px;
    background:
      linear-gradient(var(--color), var(--color)) no-repeat 0 0 / calc(var(--part) * 100%) 100%,
      var(--bg-2);
  }

  .explica {
    margin-top: 2rem;
    max-width: 44rem;
    color: var(--ink-2);
  }

  .parlament > .font-dada {
    margin-top: 1.5rem;
    max-width: 44rem;
  }

  .compte {
    margin-left: 0.5rem;
    font-size: 1.1875rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .nom-grup {
    margin-top: 0.5rem;
  }

  .diputats {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 1.75rem 1rem;
  }

  .diputats li:target img {
    outline: 3px solid var(--par);
    outline-offset: 3px;
  }

  .diputats a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .diputats img,
  .sense-foto {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 14px;
    background: var(--bg-2);
    margin-bottom: 0.5rem;
    transition: transform var(--t-bloc) var(--ease-out);
  }

  .diputats a:active img {
    transform: scale(0.985);
  }

  .diputats .nom {
    font-size: 1rem;
    line-height: 1.3;
  }

  .diputats a:hover .nom {
    text-decoration: underline;
  }

  .diputats .secundari {
    font-size: 0.875rem;
  }

  .credit {
    margin-top: 2.5rem;
  }
</style>
