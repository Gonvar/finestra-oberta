---
// Una declaració tal com la publica el Parlament: els títols, les preguntes, els textos i les taules,
// en el seu ordre. No es resumeix ni es reordena res.
import type { Bloc } from '../dades/diputats.ts';

type Props = { blocs: Bloc[] };
const { blocs } = Astro.props;
---

<div class="blocs">
  {
    blocs.map((b) =>
      'titol' in b ? (
        <h3>{b.titol}</h3>
      ) : 'pregunta' in b ? (
        <p class="pregunta">{b.pregunta}</p>
      ) : 'text' in b ? (
        b.text.map((l) => <p>{l}</p>)
      ) : 'taula' in b ? (
        <div class="taula">
          <table>
            <thead>
              <tr>
                {/* Una capçalera buida, que la font posa sobre la columna dels conceptes, no s'anuncia. */}
                {b.taula.columnes.map((c) => (c === '' ? <td /> : <th scope="col">{c}</th>))}
              </tr>
            </thead>
            <tbody>
              {b.taula.files.map((f) => (
                <tr>
                  {f.map((c) => (
                    <td>{c}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="avis">{b.avis}</p>
      ),
    )
  }
</div>

<style>
  .blocs {
    margin-top: 1rem;
    max-width: 44rem;
    color: var(--ink-2);
  }

  .blocs > * + * {
    margin-top: 0.5rem;
  }

  h3 {
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ink);
  }

  .blocs > h3:first-child {
    margin-top: 0;
  }

  .pregunta {
    margin-top: 1rem;
    color: var(--ink);
  }

  .taula {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: 0.625rem 0.75rem 0.625rem 0;
    box-shadow: inset 0 -1px 0 var(--hair);
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--ink-3);
    font-weight: 400;
  }
</style>
