---
import { VERB, type Punt, type Resultat, type Sessio } from '../dades/activitat.ts';
import { dia } from '../dades/institucions.ts';

type Props = {
  s: Sessio & { fetes: (Punt & { resultat: Resultat })[]; altres: number };
};
const { s } = Astro.props;
---

<section class="sessio" aria-labelledby={`sessio-${s.numero}`}>
  <h3 id={`sessio-${s.numero}`}>{dia(s.data)}</h3>
  <p class="secundari">Sessió {s.numero}, {s.caracter}</p>
  {
    s.fetes.length === 0 ? (
      <p class="buit">No s'hi va aprovar ni rebutjar cap iniciativa.</p>
    ) : (
      <ol class="files">
        {s.fetes.map((p) => (
          <li>
            <p class="verb">{VERB[p.resultat]}</p>
            <p class="titol">
              <a href={p.url_expedient}>{p.titol}</a>
            </p>
          </li>
        ))}
      </ol>
    )
  }
  <p class="secundari altres">
    {s.altres > 0 && `${s.altres} ${s.altres === 1 ? 'punt més' : 'punts més'}. `}<a href={s.url}
      >Tots els punts, al web del Parlament</a
    >
  </p>
</section>

<style>
  .sessio {
    margin-top: 2.5rem;
  }

  h3 {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .verb {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .titol {
    margin-top: 0.125rem;
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .titol a {
    color: inherit;
  }

  .buit {
    margin-top: 1rem;
    color: var(--ink-2);
  }

  .altres {
    margin-top: 0.75rem;
  }
</style>
