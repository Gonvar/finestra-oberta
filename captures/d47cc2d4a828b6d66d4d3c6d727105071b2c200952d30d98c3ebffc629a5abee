function renderitzarLlegendes(ctx) {
    llistaLlegendes.forEach(function(Llegenda) {
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.fillStyle = Llegenda.colorIconaLlegenda;
        ctx.rect(Llegenda.xLlegenda, Llegenda.yLlegenda, Llegenda.midaIconaLlegenda, Llegenda.midaIconaLlegenda);
        ctx.closePath();
        ctx.stroke();
        ctx.fill();

        ctx.beginPath();
        ctx.fillStyle = "black";
        ctx.font = "15px Arial";
        ctx.fillText(Llegenda.nomLlegenda, 550, Llegenda.yLlegenda + 14);
        ctx.closePath();
        ctx.stroke();
        ctx.fill();
    });
}

function renderitzarEscons(ctx) {
	//Pintem tots els escons com buits
	for (var numIndex in posicionsEscons){
		var posicio = posicionsEscons[numIndex];
		ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.fillStyle = 'white';
        ctx.arc(posicio.x, posicio.y, midaEsco, 0, 2 * Math.PI);
        ctx.closePath();
        ctx.stroke();
        ctx.fill();
	}
	
	//Pintem els escons plens
    llistaEscons.forEach(function(esco) {
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.fillStyle = esco.colorEsco;
        ctx.arc(esco.xEsco, esco.yEsco, esco.midaEsco, 0, 2 * Math.PI);
        ctx.closePath();
        ctx.stroke();
        ctx.fill();
    });
}

function afegirEsco(mida, color, num, nomDiputat, titol, subtitol, imatgeUrl, nomGrup, urlFitxa) {
    var posicio = posicionsEscons[num];
	var index = -1;	
	
    if(posicio != null) {
      llistaEscons.push({
        colorEsco: color,
        midaEsco: mida,
        xEsco: posicio.x,
        yEsco: posicio.y,
        numEsco: num,
        nomDiputatEsco: nomDiputat,
        titolEsco: titol,
        subtitolEsco: subtitol,
        imatgeUrlEsco: imatgeUrl,
		nomGrupDiputat: nomGrup,
		urlFitxaDiputat: urlFitxa
      });
    }
	
}

function afegirLlegenda(color, nom) {
    llistaLlegendes.push({
        nomLlegenda: nom,
        colorIconaLlegenda: color,
        midaIconaLlegenda: 15,
        midaTextLlegenda: 14,
        xLlegenda: 520,
        yLlegenda: altLlegenda
    });

    altLlegenda = altLlegenda + separacioLlegenda;
}

function calcularMidaImatge(imgAmple, imgAlt, maxAmple, maxAlt) {

    var ratio = [maxAmple / imgAmple, maxAlt / imgAlt];
    ratio = Math.min(ratio[0], ratio[1]);

    return {
        ample: imgAmple * ratio,
        alt: imgAlt * ratio
    };
}

function getMousePos(canvas, evt) {
	var rect = canvas.getBoundingClientRect();
	return {
	  x: evt.clientX - rect.left,
	  y: evt.clientY - rect.top
	};
}

function getTouchPos(canvas, evt) {
  var rect = canvas.getBoundingClientRect();
  return {
    x: evt.touches[0].clientX - rect.left,
    y: evt.touches[0].clientY - rect.top
  };
}

function pintaDetallEsco(esco, midaLinia){
	//Seleccio punt esco
	ctxOverlay.clearRect(0, 0, 950, 525);
	ctxOverlay.lineWidth = 0.5;
	ctxOverlay.beginPath();
	ctxOverlay.fillStyle = "black";
	ctxOverlay.arc(esco.xEsco, esco.yEsco, 2, 0, 2 * Math.PI);
	ctxOverlay.closePath();
	ctxOverlay.stroke(); 
	ctxOverlay.fill();

	//Detall esco
	ctxOverlay.lineWidth = midaLinia;
	ctxOverlay.beginPath();
	ctxOverlay.fillStyle = "Transparent";
	//ctxOverlay.rect(430, 400, 500, 100);
	ctxOverlay.rect(500, 420, 440, 90);
	ctxOverlay.closePath();
	ctxOverlay.stroke();
	ctxOverlay.fill();

	//Dades esco
	ctxOverlay.beginPath();
	ctxOverlay.fillStyle = "black";
	ctxOverlay.font = "12px Arial";
	//ctxOverlay.fillText(esco.numEsco, 515, 450);
	ctxOverlay.fillText(esco.nomDiputatEsco, 515, 460);
	ctxOverlay.fillText(esco.titolEsco, 515, 480);
	ctxOverlay.fillText(esco.subtitolEsco, 515, 440);
	ctxOverlay.fillText(esco.nomGrupDiputat, 515, 500);
	ctxOverlay.closePath();
	ctxOverlay.stroke();
	ctxOverlay.fill(); 

	var imgDiputat = new window.Image();
	imgDiputat.addEventListener("load", function() {
		var midaImatge = calcularMidaImatge(imgDiputat.width, imgDiputat.height, 110, 110);
		ctxOverlay.drawImage(imgDiputat, 820, 295, midaImatge.ample, midaImatge.alt);

	});
	imgDiputat.setAttribute("src", esco.imatgeUrlEsco);
	
}

function resaltaEscoCoord(x, y) {
	llistaEscons.forEach(function(esco) {
		var mouseDinsDetall = y > 400 && y < 500 && x > 430 && x < 830;
		var mouseDinsEsco = y > esco.yEsco - esco.midaEsco && y < esco.yEsco + esco.midaEsco && x > esco.xEsco - esco.midaEsco && x < esco.xEsco + esco.midaEsco;
		
		if(escoSeleccionat == esco.numEsco){
			if (mouseDinsDetall) {						
				if(!detallSeleccionat){ //Resaltem la finestra de detall
					pintaDetallEsco(esco, 2);
					detallSeleccionat = true;
					document.body.style.cursor = 'pointer';
				}
			}else if (detallSeleccionat){ //Deixem de resaltar la finestra de detall
				pintaDetallEsco(esco, 0.3);
				detallSeleccionat = false;
				document.body.style.cursor = 'auto';
			}else if (mouseDinsEsco){ //Ens mantenim dins del esco seleccionat
				document.body.style.cursor = 'pointer';
			}else{ //Deixem de estar dins del esco seleccionat i de la vista de detall
				document.body.style.cursor = 'auto';
			}					
		} else if (mouseDinsEsco) { //Canviem el esco seleccionat actualment			
			document.body.style.cursor = 'pointer';
			escoSeleccionat = esco.numEsco;
			pintaDetallEsco(esco, 0.3);
		}
	});	
}

function inicialitzar() {
    var img = new window.Image();
    img.addEventListener("load", function() {
        ctx.drawImage(img, 10, 10);
        renderitzarLlegendes(ctx);
        renderitzarEscons(ctx);
    });
	
    img.setAttribute("src", "/imatges/hemicicle_separadors.png");

    cOverlay.addEventListener('mousemove',
        function(event) {
			var mousePos = getMousePos(cOverlay, event);
            var x = mousePos.x,
                y = mousePos.y;			
			resaltaEscoCoord(x, y);
        }, false);
	cOverlay.addEventListener('touchmove',
        function(event) {
			var mousePos = getTouchPos(cOverlay, event);
            var x = mousePos.x,
                y = mousePos.y;			
			resaltaEscoCoord(x, y);
        }, false);
	cOverlay.addEventListener('touchdown',
        function(event) {
			var mousePos = getTouchPos(cOverlay, event);
            var x = mousePos.x,
                y = mousePos.y;			
			resaltaEscoCoord(x, y);
        }, false);	
		
	cOverlay.addEventListener('mousedown',

        function(event) {
			var mousePos = getMousePos(cOverlay, event);
            var x = mousePos.x,
                y = mousePos.y;
			
			//Verificar si fem click sobre el cuadre de dades del diputat
			if (y > 400 && y < 500 && x > 430 && x < 830) {
				llistaEscons.forEach(function(esco) {
					if(esco.numEsco == escoSeleccionat){
						var win = window.open(esco.urlFitxaDiputat, '_blank');
						win.focus();
					}
				});				
            }
			if(!isMobile.any()){
				//Verificar si fem click en un esco concret 
				llistaEscons.forEach(function(esco) {
					if (y > esco.yEsco - esco.midaEsco && y < esco.yEsco + esco.midaEsco && x > esco.xEsco - esco.midaEsco && x < esco.xEsco + esco.midaEsco) {
						var win = window.open(esco.urlFitxaDiputat, '_blank');
						win.focus();
					}
				});
			}

        }, false);

}

